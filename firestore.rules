rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public catalogues (Read-only to signed-in users, write blocked)
    match /catalogues/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User private data subtrees
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }

      match /careerGoals/{goalId} {
        allow read, write: if isOwner(userId) && isValidId(goalId);
      }

      match /resumes/{resumeId} {
        allow read, write: if isOwner(userId) && isValidId(resumeId);
      }

      match /userSkills/{skillId} {
        allow read, write: if isOwner(userId) && isValidId(skillId);
      }

      match /skillEvidence/{evidenceId} {
        allow read, write: if isOwner(userId) && isValidId(evidenceId);
      }

      match /learningPlans/{planId} {
        allow read, write: if isOwner(userId) && isValidId(planId);

        match /tasks/{taskId} {
          allow read, write: if isOwner(userId) && isValidId(taskId);
        }
      }

      match /projects/{projectId} {
        allow read, write: if isOwner(userId) && isValidId(projectId);
      }

      match /interviewSessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);

        match /scores/{scoreId} {
          allow read, write: if isOwner(userId) && isValidId(scoreId);
        }
      }

      match /applications/{applicationId} {
        allow read, write: if isOwner(userId) && isValidId(applicationId);

        match /events/{eventId} {
          allow read, write: if isOwner(userId) && isValidId(eventId);
        }
      }

      match /conversations/{threadId} {
        allow read, write: if isOwner(userId) && isValidId(threadId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isValidId(messageId);
        }
      }

      match /memoryItems/{memoryId} {
        allow read, write: if isOwner(userId) && isValidId(memoryId);
      }

      match /agentRuns/{runId} {
        allow read, write: if isOwner(userId) && isValidId(runId);
      }
    }
  }
}
